{
  "id": "/shop-app",
  "name": "Duwaz Shop Dashboard",
  "short_name": "Duwaz Shop",
  "description": "Manage your Duwaz shop, orders, stock, and customer messages.",
  "start_url": "/shop-app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f7f3ee",
  "theme_color": "#4b2e1f",
  "orientation": "any",
  "icons": [
    { "src": "/DuwazLogo.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/DuwazLogo.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
